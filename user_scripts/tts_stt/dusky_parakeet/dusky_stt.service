[Unit]
Description=Dusky STT (CPU daemon with on-demand hardware-matched ASR worker)
Documentation=file:%h/.local/lib/dusky-stt/README.md
After=graphical-session.target pipewire.service wireplumber.service pipewire-pulse.service
Wants=pipewire.service wireplumber.service
PartOf=graphical-session.target
ConditionEnvironment=XDG_RUNTIME_DIR

[Service]
Type=notify
NotifyAccess=main
WorkingDirectory=%h/.local/lib/dusky-stt
ExecStartPre=%h/.local/lib/dusky-stt/.venv-main/bin/python %h/.local/lib/dusky-stt/dusky_main.py --config %h/.local/lib/dusky-stt/config.json --check-cpu-isolation
ExecStart=%h/.local/lib/dusky-stt/.venv-main/bin/python %h/.local/lib/dusky-stt/dusky_main.py --config %h/.local/lib/dusky-stt/config.json
Environment=CUDA_VISIBLE_DEVICES=-1
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONNOUSERSITE=1
Environment=HF_HOME=%h/.cache/huggingface
Environment=HF_HUB_OFFLINE=1
RuntimeDirectory=dusky-stt
RuntimeDirectoryMode=0700
StateDirectory=dusky-stt
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=2s
TimeoutStartSec=120s
TimeoutStopSec=30s
WatchdogSec=30s
KillMode=mixed
KillSignal=SIGTERM
OOMPolicy=stop
MemoryHigh=6G
MemoryMax=8G
MemorySwapMax=1G
TasksMax=192
LimitNOFILE=8192
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/dusky-stt %h/.cache/huggingface %h/.local/share/dusky-stt
ReadOnlyPaths=%h/.local/lib/dusky-stt
PrivateTmp=yes
ProtectProc=invisible
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
# NOTE: no IPAddressAllow/Deny here on purpose: user units run without the
# privilege to program the IP firewall (log shows "unit configures an IP
# firewall, but not running as root"). AF_UNIX+NETLINK+INET via
# RestrictAddressFamilies plus localhost-only Ollama use is the enforceable part.
# NVRTC JIT needs WX pages; PipeWire needs RTKit priority.
MemoryDenyWriteExecute=no
RestrictRealtime=no

[Install]
WantedBy=graphical-session.target
