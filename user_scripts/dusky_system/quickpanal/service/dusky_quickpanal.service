[Unit]
Description=Dusky Quick Panal Daemon
After=graphical-session.target
PartOf=graphical-session.target

# Permit up to 50 starts in 10 seconds; repeated crashes can still hit the limit.
StartLimitIntervalSec=10
StartLimitBurst=50

[Service]
Type=dbus
BusName=org.dusky.quickpanal

# PYTHONOPTIMIZE=2 removes asserts and docstrings; MALLOC_ARENA_MAX=1 limits glibc arenas.
Environment=PYTHONUNBUFFERED=1 PYTHONOPTIMIZE=2 MALLOC_ARENA_MAX=1

ExecStart=%h/user_scripts/dusky_system/quickpanal/dusky_quickpanal.py --gapplication-service
Slice=app-graphical.slice

Restart=on-failure
# Skip failed/inactive transitions during automatic restarts.
RestartMode=direct

# Back off repeated restarts from 250ms up to 4s.
RestartSec=250ms
RestartSteps=5
RestartMaxDelaySec=4s
RestartPreventExitStatus=5

TimeoutStopSec=2s
# Kill remaining service processes if graceful shutdown exceeds two seconds.
TimeoutStopFailureMode=kill

MemoryAccounting=yes
# Kill the remaining service processes if one is killed by the OOM manager.
OOMPolicy=kill
OOMScoreAdjust=400

# Above 150M, memory.high applies reclaim pressure and throttling; it does not guarantee swap.
MemoryHigh=150M
# At 300M, the cgroup can be killed by the OOM manager.
MemoryMax=300M

SyslogIdentifier=dusky-quickpanal

[Install]
WantedBy=graphical-session.target
