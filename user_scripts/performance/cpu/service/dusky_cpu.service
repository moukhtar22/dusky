[Unit]
Description=Dusky CPU Core and Power Limiter Restorer
After=local-fs.target systemd-modules-load.service
Before=multi-user.target
RequiresMountsFor=/home

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/bash -c 'for d in /home/*; do [ -d "$d" ] && [ -f "$d/user_scripts/performance/cpu/tui_dusky_core_manager.py" ] && exec /usr/bin/python3 "$d/user_scripts/performance/cpu/tui_dusky_core_manager.py" --restore-all; done'

[Install]
WantedBy=multi-user.target
