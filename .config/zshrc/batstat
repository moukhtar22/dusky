# =============================================================================
# ~/.config/zshrc/batstat — zero-fork battery telemetry (Arch · Zsh 5.9+)
#
#   batstat [live|static] [human|json|terse] [TARGET|all] [-i SECONDS]
#   bare `batstat` prints help.  TARGET is a /sys/class/power_supply node name.
#
#   Sourced from ~/.zshrc [6] — SOURCED, never executed.  $HOME/sysfs only.
#
#   Forks: 0 in every mode, including the live TUI's inter-frame wait.
#   Floats: none.  ALL arithmetic is 64-bit integer (energy µWh, power µW,
#   time s), so output is byte-identical in every locale — zsh applies
#   LC_NUMERIC from LC_ALL/LANG, which silently turns "%.2f" into "6,42"
#   and destroys JSON for Waybar/Eww.  Integers cannot be mis-rendered.
#
#   Headroom: charge 1e7 µAh * voltage 1.2e7 µV = 1.2e14  <<  2^63-1.
#
#   Spec anchors:
#     Linux Documentation/ABI/testing/sysfs-class-power
#       type, scope(System|Device), present, status, capacity,
#       power_now[µW], current_now[µA], voltage_now[µV],
#       energy_now/full[µWh], charge_now/full[µAh]
#     zshbuiltins(1)  typeset/local, read -k/-s/-u, print -r
#     zshexpn(1)      glob qualifiers (N - /), numeric glob <->, (l:n::0:)
#     zshmodules(1)   zsh/zselect (zselect -t, hundredths of a second)
#     zshmisc(1)      { try } always { cleanup }
# =============================================================================

zmodload zsh/parameter 2>/dev/null        # $builtins
zmodload zsh/zselect   2>/dev/null        # fork-free timer for live mode

typeset -g BATSTAT_SYSFS=${BATSTAT_SYSFS:-/sys/class/power_supply}
typeset -g BATSTAT_INTERVAL=${BATSTAT_INTERVAL:-1}

# -----------------------------------------------------------------------------
# Help
# -----------------------------------------------------------------------------
_batstat_help() {
    emulate -L zsh
    local -a h=(
        $'\e[1;34m::\e[0m \e[1mbatstat\e[0m — zero-fork battery telemetry'
        ''
        $'\e[1mUSAGE\e[0m'
        '  batstat [COMMAND] [FORMAT] [TARGET] [-i SECONDS]'
        ''
        $'\e[1mCOMMANDS\e[0m'
        $'  \e[32mhelp\e[0m      this page (also shown when called with no argument)'
        $'  \e[32mstatic\e[0m    print one reading and exit (default)'
        $'  \e[32mlive\e[0m      flicker-free single-line TUI'
        '            quit with  q  ENTER  ·  ESC ENTER  ·  Ctrl-C'
        ''
        $'\e[1mFORMATS\e[0m'
        $'  \e[32mhuman\e[0m     readable line (default; forced in live mode)'
        $'  \e[32mjson\e[0m      one JSON object — Waybar / Eww ready'
        $'  \e[32mterse\e[0m     capacity watts status remaining'
        ''
        $'\e[1mTARGET\e[0m'
        '  power-supply node name (BAT0, BAT1, macsmc-battery, ...)'
        $'  \e[32mall\e[0m       aggregate every system battery into one reading'
        '  omitted:  first node with type=Battery and scope=System'
        ''
        $'\e[1mOPTIONS\e[0m'
        $'  \e[32m-i, --interval N\e[0m   live refresh in seconds (default 1, range 0.05-86400)'
        ''
        $'\e[1mEXAMPLES\e[0m'
        '  batstat live'
        '  batstat static json'
        '  batstat terse static BAT1'
        '  batstat live -i 0.5 all'
    )
    print -rl -- "${h[@]}"
}

# -----------------------------------------------------------------------------
# Read one integer sysfs attribute into REPLY (absolute value).
# rc 1 = absent / unreadable / non-numeric.  Zero forks.
# stderr is redirected BEFORE the input redirection so a device that vanishes
# between the -r test and the open cannot print to the terminal.
# -----------------------------------------------------------------------------
_batstat_int() {
    local v
    REPLY=0
    [[ -r $1 ]] || return 1
    read -r v 2>/dev/null < "$1" || return 1
    [[ $v == (-|)<-> ]] || return 1
    (( REPLY = v < 0 ? -v : v ))
    return 0
}

# -----------------------------------------------------------------------------
# Minimal JSON string escape into REPLY.
# -----------------------------------------------------------------------------
_batstat_jesc() {
    emulate -L zsh
    local s=$1
    s=${s//\\/\\\\}
    s=${s//\"/\\\"}
    s=${s//[$'\n\r\t']/ }
    REPLY=$s
}

# -----------------------------------------------------------------------------
# "1" | "0.5" | "2.25"  ->  REPLY = centiseconds (integer).  rc 1 if invalid.
# String-sliced, never parsed as a float: immune to LC_NUMERIC.
# -----------------------------------------------------------------------------
_batstat_cs() {
    emulate -L zsh
    local v=$1 ip fp
    REPLY=0
    [[ $v == (<->(.<->|)|.<->) ]] || return 1
    ip=${v%%.*}
    fp=''
    [[ $v == *.* ]] && fp=${v#*.}
    ip=${ip:-0}
    fp=${(r:2::0:)fp[1,2]}          # "" -> 00 · "5" -> 50 · "05" -> 05
    (( ${#ip} > 6 )) && return 1    # >999999 s: reject before the multiply
    (( REPLY = ip * 100 + fp ))
    (( REPLY >= 5 && REPLY <= 8640000 )) || return 1   # 0.05 s .. 1 day
    return 0
}

# -----------------------------------------------------------------------------
# Resolve TARGET into the caller's `nodes` array.
#   rc 0 ok · 1 nothing found / no such node · 2 node is not a battery
# -----------------------------------------------------------------------------
_batstat_nodes() {
    emulate -L zsh
    setopt localoptions extendedglob
    local target=$1 d t s
    nodes=()

    if [[ -n $target && $target != all ]]; then
        d=$BATSTAT_SYSFS/$target
        [[ -d $d ]] || return 1
        t=''
        [[ -r $d/type ]] && read -r t 2>/dev/null < "$d/type"
        [[ $t == Battery ]] || return 2
        nodes=( "$d" )
        return 0
    fi

    # (N-/) : nullglob, and '-' makes '/' follow the symlink into /sys/devices.
    for d in $BATSTAT_SYSFS/*(N-/); do
        t=''
        [[ -r $d/type ]] && read -r t 2>/dev/null < "$d/type"
        [[ $t == Battery ]] || continue
        s=''
        [[ -r $d/scope ]] && read -r s 2>/dev/null < "$d/scope"
        [[ ${s:-System} == System ]] || continue   # skip mice / pads / headsets
        nodes+=( "$d" )
        [[ $target == all ]] || break
    done
    (( $#nodes ))
}

# -----------------------------------------------------------------------------
# Probe ONE node.  Writes the caller's locals (dynamic scope, by contract):
#   _bp_name _bp_status _bp_scope _bp_present _bp_cap _bp_enow _bp_efull _bp_power
# Energy is normalised to µWh and power to µW so that any mixture of
# energy_*/charge_* and power_now/current_now still produces a time estimate.
# -----------------------------------------------------------------------------
_batstat_probe() {
    emulate -L zsh
    local p=$1 s f REPLY
    local -i volt=0

    _bp_name=${p:t}
    _bp_status=Unknown
    _bp_scope=System
    _bp_present=1
    _bp_cap=-1
    _bp_enow=0
    _bp_efull=0
    _bp_power=0

    if [[ -r $p/scope ]]; then
        s=''; read -r s 2>/dev/null < "$p/scope"; [[ -n $s ]] && _bp_scope=$s
    fi
    if [[ -r $p/status ]]; then
        s=''; read -r s 2>/dev/null < "$p/status"; [[ -n $s ]] && _bp_status=$s
    fi
    _batstat_int "$p/present" && (( REPLY == 0 )) && _bp_present=0

    for f in voltage_now voltage_avg voltage_min_design voltage_max_design; do
        if _batstat_int "$p/$f" && (( REPLY > 0 )); then volt=$REPLY; break; fi
    done

    # remaining energy (µWh)
    if _batstat_int "$p/energy_now" && (( REPLY > 0 )); then
        _bp_enow=$REPLY
    elif (( volt > 0 )) && _batstat_int "$p/charge_now" && (( REPLY > 0 )); then
        (( _bp_enow = REPLY * volt / 1000000 ))
    fi

    # full energy (µWh)
    if _batstat_int "$p/energy_full" && (( REPLY > 0 )); then
        _bp_efull=$REPLY
    elif _batstat_int "$p/energy_full_design" && (( REPLY > 0 )); then
        _bp_efull=$REPLY
    elif (( volt > 0 )) && _batstat_int "$p/charge_full" && (( REPLY > 0 )); then
        (( _bp_efull = REPLY * volt / 1000000 ))
    elif (( volt > 0 )) && _batstat_int "$p/charge_full_design" && (( REPLY > 0 )); then
        (( _bp_efull = REPLY * volt / 1000000 ))
    fi

    # instantaneous power (µW)
    if _batstat_int "$p/power_now" && (( REPLY > 0 )); then
        _bp_power=$REPLY
    elif _batstat_int "$p/power_avg" && (( REPLY > 0 )); then
        _bp_power=$REPLY
    elif (( volt > 0 )); then
        for f in current_now current_avg; do
            if _batstat_int "$p/$f" && (( REPLY > 0 )); then
                (( _bp_power = REPLY * volt / 1000000 ))
                break
            fi
        done
    fi

    # capacity (%)
    if _batstat_int "$p/capacity" && (( REPLY <= 100 )); then
        _bp_cap=$REPLY
    elif (( _bp_efull > 0 )); then
        (( _bp_cap = (_bp_enow * 100 + _bp_efull / 2) / _bp_efull ))
    fi
    (( _bp_cap > 100 )) && _bp_cap=100
    return 0
}

# -----------------------------------------------------------------------------
# Aggregate the given nodes and emit ONE frame (no trailing newline).
# -----------------------------------------------------------------------------
_batstat_render() {
    emulate -L zsh
    setopt localoptions extendedglob
    local fmt=$1; shift
    local node names='' state=Unknown st tstr='N/A' capstr='N/A' jcap=null
    local cls=unknown wstr jn js REPLY
    local -i n=0 csum=0 ccnt=0 cap=-1 esum=0 efsum=0 psum=0 secs=0 hrs=0 mins=0 cw=0
    local _bp_name _bp_status _bp_scope
    local -i _bp_present=1 _bp_cap=-1 _bp_enow=0 _bp_efull=0 _bp_power=0

    for node in "$@"; do
        _batstat_probe "$node"
        (( _bp_present )) || continue
        # hot-unplug: a node with NO readable data at all is a vanished device,
        # not a real battery (real batteries always expose capacity + status)
        (( _bp_cap >= 0 || _bp_enow > 0 || _bp_efull > 0 || _bp_power > 0 || _bp_status != Unknown )) || continue
        (( n++ ))
        names+="${names:+ + }${_bp_name}"
        (( esum  += _bp_enow  ))
        (( efsum += _bp_efull ))
        (( psum  += _bp_power ))
        (( _bp_cap >= 0 )) && (( csum += _bp_cap, ccnt++ ))
        st=$_bp_status
        case $st in
            Charging)       state=Charging ;;
            Discharging)    [[ $state == Charging ]] || state=Discharging ;;
            'Not charging') [[ $state == (Charging|Discharging) ]] || state='Not charging' ;;
            Full)           [[ $state == (Charging|Discharging|'Not charging') ]] || state=Full ;;
            *)              [[ $state == Unknown && -n $st ]] && state=$st ;;
        esac
    done

    if (( n == 0 )); then
        print -ru2 -- 'batstat: no battery present (empty bay, or the device vanished)'
        return 1
    fi

    # capacity
    if (( n == 1 && ccnt == 1 )); then
        cap=$csum
    elif (( efsum > 0 )); then
        (( cap = (esum * 100 + efsum / 2) / efsum ))
    elif (( ccnt > 0 )); then
        (( cap = (csum + ccnt / 2) / ccnt ))
    fi
    (( cap > 100 )) && cap=100
    if (( cap >= 0 )); then capstr=$cap; jcap=$cap; fi

    # remaining time (pure integer seconds)
    if (( psum > 0 )); then
        case $state in
            Discharging) (( secs = esum * 3600 / psum )) ;;
            Charging)    (( efsum > esum )) && (( secs = (efsum - esum) * 3600 / psum )) ;;
        esac
    fi
    if (( secs > 0 )); then
        (( hrs  = secs / 3600 ))
        (( mins = (secs % 3600 + 30) / 60 ))
        (( mins >= 60 )) && (( hrs++, mins -= 60 ))
        tstr="${hrs}h${mins}m"
    else
        case $state in
            Full)           tstr=Full ;;
            'Not charging') tstr=Held ;;
        esac
    fi

    # watts, assembled from integer centiwatts — no printf, no float, no locale
    (( cw = (psum + 5000) / 10000 ))
    wstr="$(( cw / 100 )).${(l:2::0:)$(( cw % 100 ))}"

    case $state in
        Charging)       cls=charging ;;
        Discharging)    cls=discharging ;;
        Full)           cls=full ;;
        'Not charging') cls=held ;;
    esac
    (( cap >= 0 && cap <= 15 )) && [[ $state == Discharging ]] && cls=critical

    case $fmt in
        json)
            _batstat_jesc "$names";  jn=$REPLY
            _batstat_jesc "$state"; js=$REPLY
            print -rn -- "{\"name\":\"$jn\",\"capacity\":$jcap,\"power_w\":$wstr,\"status\":\"$js\",\"remaining\":\"$tstr\",\"seconds\":$secs,\"class\":\"$cls\",\"text\":\"$capstr%\",\"tooltip\":\"$jn | $js | $wstr W | $tstr\"}"
            ;;
        terse)
            print -rn -- "$capstr $wstr $state $tstr"
            ;;
        *)
            print -rn -- "Capacity: $capstr% | Power Draw: $wstr W ($state) | Remaining: $tstr"
            ;;
    esac
    return 0
}

# -----------------------------------------------------------------------------
# Public entry point
# -----------------------------------------------------------------------------
batstat() {
    emulate -L zsh
    setopt localoptions extendedglob
    local arg target='' mode=static fmt=human key REPLY
    local -a nodes avail
    local -i want_iv=0 cs=100 rc=0 tty_in=0 tty_out=0 _bs_code=0

    (( $# == 0 )) && { _batstat_help; return 0 }

    _batstat_cs "$BATSTAT_INTERVAL" && cs=$REPLY

    for arg in "$@"; do
        if (( want_iv )); then
            want_iv=0
            _batstat_cs "$arg" || { print -ru2 -- "batstat: invalid interval '$arg'"; return 2 }
            cs=$REPLY
            continue
        fi
        case $arg in
            help|-h|--help)   _batstat_help; return 0 ;;
            live|static)      mode=$arg ;;
            human|json|terse) fmt=$arg ;;
            -i|--interval)    want_iv=1 ;;
            --interval=*)
                _batstat_cs "${arg#*=}" || { print -ru2 -- "batstat: invalid interval '${arg#*=}'"; return 2 }
                cs=$REPLY ;;
            -*)
                print -ru2 -- "batstat: unknown option '$arg' — see 'batstat help'"
                return 2 ;;
            *)
                if [[ -n $target ]]; then
                    print -ru2 -- "batstat: more than one target given ('$target', '$arg')"
                    return 2
                fi
                target=$arg ;;
        esac
    done
    (( want_iv )) && { print -ru2 -- 'batstat: -i/--interval requires a value'; return 2 }

    _batstat_nodes "$target"
    rc=$?
    if (( rc )); then
        avail=( $BATSTAT_SYSFS/*(N-/) )
        avail=( ${avail[@]:t} )
        if (( rc == 2 )); then
            print -ru2 -- "batstat: '$target' exists but is not type=Battery"
        elif [[ -n $target && $target != all ]]; then
            print -ru2 -- "batstat: no such power supply: $target"
        else
            print -ru2 -- "batstat: no system battery found in $BATSTAT_SYSFS"
        fi
        (( $#avail )) && print -ru2 -- "batstat: available supplies: ${(j:, :)avail}"
        return 1
    fi

    # ---- static --------------------------------------------------------------
    if [[ $mode != live ]]; then
        _batstat_render $fmt "${nodes[@]}"
        rc=$?
        (( rc == 0 )) && print
        return $rc
    fi

    # ---- live ----------------------------------------------------------------
    if [[ $fmt != human ]]; then
        print -ru2 -- "batstat: '$fmt' is a scripting format — live mode renders 'human'."
        fmt=human
    fi
    if (( ! $+builtins[zselect] )); then
        print -ru2 -- 'batstat: live mode needs the zsh/zselect module (zmodload zsh/zselect)'
        return 1
    fi
    [[ -t 0 ]] && tty_in=1
    [[ -t 1 ]] && tty_out=1

    # Ctrl-C / SIGTERM: set a flag instead of letting the default handler kill
    # the shell mid-frame (which would skip the always block below and leave
    # the terminal cursor hidden).  `trap - INT TERM` in the cleanup restores
    # the stock interactive disposition.
    typeset -g _bs_interrupt=0
    trap 'typeset -g _bs_interrupt=1' INT TERM

    (( tty_out )) && print -rn -- $'\e[?25l'
    {
        while true; do
            (( _bs_interrupt )) && break
            if (( tty_out )); then
                print -rn -- $'\r\e[2K'
                _batstat_render $fmt "${nodes[@]}" || break
            else
                _batstat_render $fmt "${nodes[@]}" || break
                print
            fi

            if (( tty_in )); then
                # zselect is the timer (it cannot return early), -r 0 also
                # reports a waiting keystroke; a failed read means EOF -> quit,
                # so this loop can never busy-spin.
                if zselect -t $cs -r 0 2>/dev/null; then
                    key=''
                    read -s -k 1 -u 0 key 2>/dev/null || break
                    [[ $key == (q|Q|$'\e') ]] && break
                fi
            else
                zselect -t $cs 2>/dev/null
            fi
        done
    } always {
        (( tty_out )) && print -rn -- $'\e[?25h'
        print
        trap - INT TERM
        _bs_code=$_bs_interrupt
        unset _bs_interrupt
    }
    (( _bs_code )) && return 130
    return 0
}
