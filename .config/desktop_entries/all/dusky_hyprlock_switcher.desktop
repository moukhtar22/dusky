[Desktop Entry]
Type=Application
Name=Dusky Hyprlock Theme Manager
GenericName=Lock Screen Theme Switcher
Comment=Switch Hyprlock configurations interactively
Exec=foot --app-id=dusky_tui python3 /home/dusk/user_scripts/hyprlock/tui_hyprlock.py
Icon=preferences-desktop-screensaver
Terminal=false
Categories=Settings;DesktopSettings;Utility;
Keywords=dusky;hyprland;hyprlock;theme;config;
StartupNotify=true
StartupWMClass=dusky_tui
